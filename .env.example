# ==============================================================================
# CARMEN Environment Configuration
# Copy to .env for local development or configure in your secret manager.
# Missing OPTIONAL variables will NOT crash the application.
# ==============================================================================

# --- REQUIRED (for server-side AES-256-GCM BYOK Secret Vault encryption) ------
# ENCRYPTION_SECRET (preferred) or CARMEN_MASTER_KEY (compatible alias):
# Strong random secret (32+ characters) used by AES-256-GCM Secret Vault to encrypt
# saved provider API keys, project env vars, and queued APK signing credentials.
ENCRYPTION_SECRET=""
CARMEN_MASTER_KEY=""

# --- STRONGLY RECOMMENDED IN PRODUCTION ---------------------------------------
# SESSION_SECRET: Random secret used to sign scoped HMAC preview tokens and
# session helpers. Defaults to an auto-generated per-boot secret in dev if omitted.
SESSION_SECRET=""

# APP_URL: Public URL where CARMEN is hosted (used for Referer/origin metadata).
APP_URL="http://localhost:3000"

# Reverse proxy domains used by Caddyfile in docker-compose.yml
CARMEN_DOMAIN="localhost"
PREVIEW_DOMAIN=":8443"

# --- OPTIONAL INTEGRATIONS & AUTH ---------------------------------------------
# CARMEN_ENABLE_DEMO: Set to "1" to enable demo login (/api/auth/demo) and ?autostart=1.
# Disabled by default in production.
CARMEN_ENABLE_DEMO=""
CARMEN_DEMO_PASSWORD=""

# --- PLATFORM FALLBACK PROVIDER KEYS & QUOTAS (OPTIONAL) ---------------------
# User BYOK keys always take priority over platform .env fallback keys.
# When a user has not configured a key for a provider, any configured .env keys
# below act as server-side platform fallbacks subject to daily per-user quotas.
GEMINI_API_KEY=""
ANTHROPIC_API_KEY=""
OPENAI_API_KEY=""
OPENROUTER_API_KEY=""
GROQ_API_KEY=""
COARENA_API_KEY=""
CARMEN_SHARED_KEY_MAX_REQUESTS_PER_DAY="100"
CARMEN_SHARED_KEY_MAX_TOKENS_PER_DAY="500000"
CARMEN_SHARED_KEY_MAX_COST_USD_PER_DAY="5"

# PREVIEW_ORIGIN: Optional separate origin/domain for isolated preview hosting
# in production (e.g. https://preview.example.com). Leave empty for same-origin
# opaque-sandbox preview deployment.
PREVIEW_ORIGIN=""

# CARMEN_DB_PATH: Optional custom file path for the SQLite database.
# Defaults to ./data/carmen.db (sandboxes and artifacts live alongside it).
CARMEN_DB_PATH=""

# --- DATABASE DRIVER (SQLITE DEFAULT OR POSTGRESQL) -----------------------------
# CARMEN_DB_DRIVER: "sqlite" (default single-instance with WAL + migrations) or
# "postgres" (multi-instance PostgreSQL runtime requiring valid DATABASE_URL).
CARMEN_DB_DRIVER="sqlite"
DATABASE_URL=""
PG_POOL_MAX="20"
PG_IDLE_TIMEOUT_MS="30000"
PGSSLMODE="require"
PGBOUNCER_ENABLED="false"
PGBOUNCER_POOL_MODE="transaction"

# --- ASYNC ANDROID APK BUILD QUEUE (REDIS + BULLMQ) ---------------------------
# REDIS_URL: When set (e.g. redis://redis:6379), APK/AAB builds run asynchronously
# through BullMQ in a dedicated worker (`npm run worker:apk`). When unset, builds run
# asynchronously in-process without blocking HTTP requests.
REDIS_URL=""
CARMEN_REQUIRE_REDIS_QUEUE=""
APK_MAX_CONCURRENT_PER_USER="2"
APK_WORKER_CONCURRENCY="2"

# --- SANDBOX ISOLATION & PREVIEW LIFECYCLE TUNING -----------------------------
# CARMEN_SANDBOX_DRIVER: Force a specific OS isolation driver:
#   auto (default) | docker | podman | linux-namespace
# Note: "restricted-host" fails closed (refuses unsandboxed command execution).
CARMEN_SANDBOX_DRIVER=""

# CARMEN_SANDBOX_IMAGE: OCI container image used when docker/podman driver is active.
CARMEN_SANDBOX_IMAGE="node:22-alpine"

# Strict per-container resource limits enforced in Docker/Podman & Linux namespaces
SANDBOX_MAX_CPU="0.5"
SANDBOX_MAX_MEMORY_MB="512"

# Auto-sleep live previews after inactivity (ms) and per-user concurrency limit
PREVIEW_IDLE_TIMEOUT_MS="900000"
PREVIEW_MAX_CONCURRENT_PER_USER="3"

# CARMEN_SANDBOX_OFFLINE_ONLY: Set to "1" to enforce network=none even for npm install & Gradle.
CARMEN_SANDBOX_OFFLINE_ONLY=""

# CARMEN_SANDBOX_ALLOW_NPM_SCRIPTS: Set to "1" to allow npm preinstall/postinstall lifecycle scripts.
# Default is disabled (--ignore-scripts enforced for security).
CARMEN_SANDBOX_ALLOW_NPM_SCRIPTS=""

# --- OPTIONAL NATIVE ANDROID APK BUILD TOOLCHAIN ------------------------------
# ANDROID_HOME / ANDROID_SDK_ROOT: Path to Android SDK on hosts/workers that
# compile native Android .apk artifacts with JDK 17+ and Gradle.
# When absent, CARMEN honestly outputs a Capacitor Android source bundle (.zip).
ANDROID_HOME=""
ANDROID_SDK_ROOT=""

# CARMEN_ANDROID_BUILDER_IMAGE: OCI image used for Gradle builds when docker/podman driver is active.
CARMEN_ANDROID_BUILDER_IMAGE="ghcr.io/cirruslabs/android-sdk:34"

# --- LARGE PROJECT & AGENT ORCHESTRATOR TUNING --------------------------------
# Per-file size ceiling in bytes (16384 - 5242880, default 524288 = 512 KB)
CARMEN_MAX_FILE_BYTES="524288"
# Max files per project (20 - 5000, default 500)
CARMEN_MAX_PROJECT_FILES="500"
# Max tool-calling agent steps per turn (5 - 200, default 100)
CARMEN_MAX_AGENT_STEPS="100"
# Max automatic build/test repair cycles per turn (1 - 10, default 5)
CARMEN_MAX_AUTO_FIX_CYCLES="5"
# Max processes/threads inside sandboxed command (16 - 4096, default 128)
SANDBOX_MAX_PROCS="128"

# --- CONCURRENCY & RUNTIME RESOURCE BUDGET OVERRIDES (OPTIONAL) ---------------
# Leave blank to auto-compute safely from host CPU/RAM capacity.
CARMEN_MAX_CONCURRENT_SANDBOXES=""
CARMEN_MAX_CONCURRENT_AGENT_SESSIONS=""
CARMEN_MAX_CONCURRENT_APK_BUILDS=""
CARMEN_API_RATE_LIMIT_PER_MIN="600"

